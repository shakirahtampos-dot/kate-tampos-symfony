{% extends 'base.html.twig' %}

{% block title %}Checkout | Kates Goodies{% endblock %}

{% block body %}
<main class="checkout-page">
    <div class="checkout-heading">
        <p class="eyebrow">Your Order</p>
        <h1>Checkout</h1>
        <p>Review your order. You will pick up your order at the bakery.</p>
    </div>

    <div class="checkout-layout">
        <section class="checkout-products">
            <div class="checkout-section-title">
                <h2>Order Summary</h2>
                <span>{{ items|length }} item{{ items|length != 1 ? 's' : '' }}</span>
            </div>

            {% for item in items %}
                <div class="checkout-item">
                    {% if item.image %}
                        <img src="/{{ item.image|trim('/', 'left') }}" alt="{{ item.name }}">
                    {% endif %}
                    <div class="checkout-item-info">
                        <h3>{{ item.name }}</h3>
                        <p>₱{{ item.price|number_format(2) }} × {{ item.quantity }}</p>
                    </div>
                    <strong class="checkout-item-total">₱{{ item.subtotal|number_format(2) }}</strong>
                </div>
            {% endfor %}
        </section>

        <aside class="checkout-summary">
            <p class="eyebrow">Pickup</p>
            <h2>Your Details</h2>

            <form action="{{ path('app_order_place') }}" method="POST">
                <div class="address-form">
                    <label for="delivery_address">Address</label>
                    <textarea id="delivery_address" name="delivery_address" rows="4"
                        placeholder="House/Unit No., Street, Barangay, City, Province" required></textarea>
                    <small>Pickup only. We don't deliver. Your address is for our records.</small>
                </div>

                <div class="checkout-summary-row">
                    <span>Subtotal</span>
                    <span>₱{{ total|number_format(2) }}</span>
                </div>

                <div class="checkout-divider"></div>

                <div class="checkout-total">
                    <span>Total</span>
                    <strong>₱{{ total|number_format(2) }}</strong>
                </div>

                <button type="submit" class="checkout-button">Place Order</button>
            </form>

            <a href="{{ path('app_cart') }}" class="checkout-back">← Back to Cart</a>
        </aside>
    </div>
</main>
{% endblock %}