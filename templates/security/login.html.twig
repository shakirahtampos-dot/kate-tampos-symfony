<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Kates Goodies</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

<div class="login-container">
    <div class="login-box">

        <div class="logo">
            <h1>Kates Goodies</h1>
            <p>FRESHLY BAKED EVERY DAY</p>
        </div>

        <div class="login-title">
            <h2>Welcome Back</h2>
            <p>Login to your account</p>
        </div>

        {% if app.request.query.has('registered') %}
            <div class="success">
                Account created successfully. You can now log in.
            </div>
        {% endif %}

        {% for message in app.flashes('error') %}
            <div class="error">{{ message }}</div>
        {% endfor %}

        {% if error_message %}
            <div class="error">
                {{ error_message }}
            </div>
        {% endif %}

        <form method="POST" action="{{ path('app_login') }}">

            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="_username" value="{{ last_username }}" placeholder="Enter your email" required>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="_password" placeholder="Enter your password" required>
            </div>

            <input type="hidden" name="_remember_me" value="on">

            <button type="submit" class="login-btn">Login</button>

        </form>

        <div class="register-link">
            Don't have an account?
            <a href="{{ path('app_register') }}">Create one</a>
        </div>

        <a href="{{ path('app_home') }}" class="back-link">← Back to Home</a>

    </div>
</div>

</body>
</html>