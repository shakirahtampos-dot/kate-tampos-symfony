<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users - Kates Goodies</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<div class="admin-container">

    <div class="admin-header">
        <div>
            <p class="eyebrow">Admin Panel</p>
            <h1>Manage Users</h1>
            <p>Create and manage admin, staff, and customer accounts.</p>
        </div>

        <div>
            <a href="{{ path('app_admin_user_new') }}" class="admin-back">+ Add User</a>
            <a href="{{ path('app_admin') }}" class="admin-back">Dashboard</a>
        </div>
    </div>

    {% for message in app.flashes('admin_success') %}
        <div class="admin-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('admin_error') %}
        <div style="background:#fde8e8;color:#9b1c1c;padding:12px 20px;margin-bottom:16px;">{{ message }}</div>
    {% endfor %}

    <form method="GET" action="{{ path('app_admin_users') }}" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
        <input type="text" name="q" value="{{ q }}" placeholder="Search name or email" style="padding:10px;flex:1;min-width:180px;">
        <select name="role" style="padding:10px;">
            <option value="">All roles</option>
            {% for r in roles %}
                <option value="{{ r }}" {{ role == r ? 'selected' : '' }}>{{ r|capitalize }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="admin-update-button">Search</button>
    </form>

    <div class="admin-orders">

        <div class="admin-section-header">
            <h2>All Accounts</h2>
            <span>{{ users|length }} account{{ users|length != 1 ? 's' : '' }}</span>
        </div>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Date Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                        <tr>
                            <td><strong>{{ u.full_name }}</strong></td>
                            <td>{{ u.email }}</td>
                            <td>{{ u.role|capitalize }}</td>
                            <td>{{ u.is_active ? 'Active' : 'Disabled' }}</td>
                            <td>{{ u.created_at|date('M d, Y') }}</td>
                            <td>
                                <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="admin-view-button">Edit</a>

                                {% if u.id != app.user.id %}
                                    <form method="POST" action="{{ path('app_admin_user_toggle', {id: u.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('user_action') }}">
                                        <button type="submit" class="admin-view-button" style="cursor:pointer;font:inherit;">{{ u.is_active ? 'Disable' : 'Enable' }}</button>
                                    </form>

                                    <form method="POST" action="{{ path('app_admin_user_delete', {id: u.id}) }}" style="display:inline;"
                                          onsubmit="return confirm('Are you sure you want to delete this account?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('user_action') }}">
                                        <button type="submit" class="admin-view-button" style="cursor:pointer;font:inherit;">Delete</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">No accounts found.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

</div>

</body>
</html>