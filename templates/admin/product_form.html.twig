<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ heading }} - Kates Goodies</title>
    <link rel="stylesheet" href="/css/{{ css }}">
</head>
<body>

<div class="container">

    <h1>{{ heading }}</h1>
    <p>{{ subtitle }}</p>

    {% if error %}
        <div class="message">{{ error }}</div>
    {% endif %}

    <form method="POST">
        <input type="hidden" name="_token" value="{{ csrf_token('product_form') }}">

        <div class="form-group">
            <label for="name">Product Name *</label>
            <input type="text" id="name" name="name" value="{{ product.name }}" required>
        </div>

        <div class="form-group">
            <label for="description">Description *</label>
            <textarea id="description" name="description" required>{{ product.description }}</textarea>
        </div>

        <div class="form-group">
            <label for="price">Price *</label>
            <input type="number" id="price" name="price" step="0.01" min="0" value="{{ product.price }}" required>
        </div>

        <div class="form-group">
            <label for="tag">Tag</label>
            <input type="text" id="tag" name="tag" value="{{ product.tag }}" placeholder="Bestseller, Daily Pick, Limited...">
        </div>

        <div class="form-group">
            <label for="image">Image Path or URL</label>
            <input type="text" id="image" name="image" value="{{ product.image }}" placeholder="images/product.jpg or https://...">
        </div>

        <div class="form-group">
            <label for="stock">Stock *</label>
            <input type="number" id="stock" name="stock" min="0" value="{{ product.stock }}" required>
        </div>

        <div class="buttons">
            <button type="submit">{{ submit }}</button>
            <a href="{{ path('app_admin_products') }}" class="back-button">{{ cancel }}</a>
        </div>

    </form>

</div>

</body>
</html>